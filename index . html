<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Каталог товаров</title>
    <style>
        :root {
            --bg-color: #f9f9f9;
            --card-bg: #ffffff;
            --text-color: #333333;
            --accent-color: #0088cc;
            --border-color: #e0e0e0;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
        }
        header {
            text-align: center;
            margin-bottom: 30px;
        }
        h1 {
            font-size: 24px;
            margin-bottom: 5px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }
        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            background-color: #eee;
        }
        .card-content {
            padding: 15px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .card-title {
            font-size: 16px;
            font-weight: 600;
            margin: 0 0 8px 0;
        }
        .card-price {
            font-size: 15px;
            font-weight: bold;
            color: #111;
            margin-bottom: 8px;
        }
        .card-stock {
            font-size: 13px;
            color: #666;
            margin-bottom: 12px;
        }
        .btn-tg {
            margin-top: auto;
            background-color: var(--accent-color);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 10px;
            text-align: center;
            text-decoration: none;
            font-weight: 500;
        }
    </style>
</head>
<body>

    <header>
        <h1>Каталог</h1>
        <p>Выберите товар и оформите заказ через Telegram</p>
    </header>

    <div class="container" id="product-grid"></div>

    <script>
        fetch('products.json')
            .then(response => response.json())
            .then(data => {
                const grid = document.getElementById('product-grid');
                grid.innerHTML = '';
                
                data.products.forEach(product => {
                    const tgMessage = encodeURIComponent(`Привет! Хочу купить: ${product.title}`);
                    const tgLink = `https://t.me/ваш_юзернейм?text=${tgMessage}`;

                    const card = document.createElement('div');
                    card.className = 'card';
                    card.innerHTML = `
                        <img src="${product.image}" alt="${product.title}">
                        <div class="card-content">
                            <h3 class="card-title">${product.title}</h3>
                            <div class="card-price">${product.price}</div>
                            <div class="card-stock">В наличии: ${product.stock} шт.</div>
                            <a href="${tgLink}" target="_blank" class="btn-tg">Заказать в Telegram</a>
                        </div>
                    `;
                    grid.appendChild(card);
                });
            })
            .catch(err => {
                document.getElementById('product-grid').innerHTML = '<p style="text-align:center; grid-column: 1/-1;">Загрузка каталога...</p>';
            });
    </script>
</body>
</html>
